# BuildSmart AI - Environment Variables Template
# Copy this file to .env.local and populate with your credentials.

# Supabase Configuration (Required for database & auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Optional, strictly for administrative server tasks)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI API Key (Required for live AI chatbot and live AI material recommendations)
# If omitted or invalid, BuildSmart AI automatically runs with built-in engineering heuristics and fallback offline modes
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
