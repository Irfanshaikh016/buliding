# BuildSmart AI - Environment Variables Template
# Copy this file to .env.local and populate with your credentials.

# Supabase Configuration (Required for cloud database & auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Optional, strictly for administrative server tasks)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API Key (100% Free tier available at https://aistudio.google.com/)
# Recommended for college mini-projects & viva demonstrations
GEMINI_API_KEY=AIzaSy-your-free-gemini-api-key-here

# Optional: OpenAI API Key (Alternative AI provider)
OPENAI_API_KEY=

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
